      this.addTestResult(`代码执行异常：${JSON.stringify(err)}`);
      tlsServer.close();
    }
  }

  /**
   * 辅助方法：创建 TLS 客户端连接服务器，触发无效加密套件的握手错误
   */
  private triggerInvalidCipherError(port: number) {
    const tlsClient = socket.constructTLSSocketInstance();
    const clientOptions: socket.TLSConnectOptions = {
      address: { address: '127.0.0.1', port: port },
      secureOptions: {
        protocols: socket.Protocol.TLSv12,
        cipherSuite: "ECDHE-RSA-AES128-GCM-SHA256",
      }
    };

    // 客户端连接，触发服务器的 TLS 握手错误
    tlsClient.connect(clientOptions).then(() => {
      console.info("客户端连接成功");
    }).catch((err: BusinessError) => {
      console.info("客户端连接失败: " + JSON.stringify(err));
    });
  }

  // 添加测试结果
  addTestResult(result: string): void {
    this.testResults = [...this.testResults, result];
    console.info(`测试结果: ${result}`);
  }

  // 清空测试结果
  clearTestResults(): void {
    this.testResults = [];
  }

