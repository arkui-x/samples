      .scrollable(ScrollDirection.Vertical)
      .height(100)
      .margin({ top: 10 })
      .padding(10)
      .border({ width: 1, color: '#dddddd' })

    }
    .width('100%')
    .height('100%')
    .padding(20)
    .backgroundColor('#f0f0f0')
  }
}