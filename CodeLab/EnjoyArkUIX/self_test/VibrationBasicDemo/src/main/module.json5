{
  "module": {
    "name": "VibrationBasicDemo",
    "type": "feature",
    "description": "$string:module_desc",
    "mainElement": "VibrationBasicDemoAbility",
    "deviceTypes": [
      "default"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "VibrationBasicDemoAbility",
        "srcEntry": "./ets/vibrationbasicdemoability/VibrationBasicDemoAbility.ets",
        "description": "$string:VibrationBasicDemoAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:VibrationBasicDemoAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.VIBRATE"
      },
      {
        "name": "ohos.permission.INTERNET",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      }
    ]
  }
}